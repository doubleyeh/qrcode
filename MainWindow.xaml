<Window x:Class="QrCodeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="二维码生成器" Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Input" Grid.Row="0" FontSize="14"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="Input_TextChanged"/>
        <Border Grid.Row="1" Margin="0,12,0,0" Background="White"
                BorderBrush="#DDD" BorderThickness="1">
            <Image x:Name="QrImage" Margin="8" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="0,8,0,0" Foreground="#666"
                   Text="选中文本后按 Shift+Alt+Q"/>
    </Grid>
</Window>
